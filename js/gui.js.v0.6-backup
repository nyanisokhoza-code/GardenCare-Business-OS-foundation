(()=>{
const KEY='gardencare_os_v06';
const seed={customers:[],quotes:[],jobs:[],invoices:[],employees:[],applicants:[],expenses:[],assessments:[],settings:{bagCost:50,coverageM2:40,wastePct:10,reserveBags:1,labourRate:180,dieselPrice:30,fuelKmPerLitre:12,equipment:150,overheadPct:5,markupPct:30,monthlyMax:2300}};
let db=load(), route='dashboard', smart={step:1,customerId:null,area:0,measurements:[],media:[],service:'Lawn restoration',property:{}};
const nav=[['dashboard','🏠','Home'],['smart','⚡','New Job'],['customers','👤','Customers'],['properties','📍','Properties'],['scan','🌱','GardenScan'],['quotes','📋','Quotes'],['jobs','🛠️','Jobs'],['employees','👷','Employees'],['recruitment','👥','Recruitment'],['training','🎓','Training'],['financials','💳','Financials'],['reports','📊','Reports'],['ai','🤖','AI Assistant'],['developer','⚙️','Settings']];
const $=s=>document.querySelector(s), esc=s=>String(s??'').replace(/[&<>"']/g,c=>({'&':'&amp;','<':'&lt;','>':'&gt;','"':'&quot;',"'":'&#39;'}[c]));
function load(){try{return {...structuredClone(seed),...JSON.parse(localStorage.getItem(KEY)||'{}')}}catch{return structuredClone(seed)}}
function save(){localStorage.setItem(KEY,JSON.stringify(db));render()}; function id(p){return p+'-'+Math.random().toString(36).slice(2,8).toUpperCase()}; function money(n){return 'R '+Number(n||0).toLocaleString('en-ZA',{minimumFractionDigits:2,maximumFractionDigits:2})};
function help(title,text){return `<button class="help" data-help="${esc(title)}|${esc(text)}" aria-label="Help">i</button>`};
function field(label,name,value='',type='text',hint='',full=false){return `<div class="field ${full?'full':''}"><label>${esc(label)} ${help(label,hint||`Enter ${label.toLowerCase()}.`)}</label><input name="${esc(name)}" type="${type}" value="${esc(value)}"><span class="hint">${esc(hint)}</span></div>`}
function calc(area){const s=db.settings, raw=Math.max(0,Number(area)||0)/Math.max(.1,s.coverageM2), withWaste=raw*(1+s.wastePct/100), required=Math.ceil(withWaste), take=required+Number(s.reserveBags||0), material=take*s.bagCost, labour=s.labourRate*3, travel=s.dieselPrice*20/Math.max(1,s.fuelKmPerLitre), equip=s.equipment, subtotal=material+labour+travel+equip, overhead=subtotal*s.overheadPct/100, cost=subtotal+overhead, sell=cost*(1+s.markupPct/100);return {raw,withWaste,required,take,material,labour,travel,equip,overhead,cost,sell}}
function toast(t){const x=document.createElement('div');x.className='toast';x.textContent=t;document.body.appendChild(x);setTimeout(()=>x.remove(),2600)}
function layout(title,sub,body){return `<div class="section-head"><div><h2>${title}</h2><p>${sub}</p></div></div>${body}`}
function metric(label,val,sub=''){return `<div class="card metric"><span class="label">${label}</span><b>${val}</b><small>${sub}</small></div>`}
function navHTML(){return nav.map(([r,i,t])=>`<button class="${route===r?'active':''}" data-route="${r}">${i}<span>${t}</span></button>`).join('')}
function shell(){return `<div class="shell" id="shell"><aside class="side"><div class="brand"><div class="brand-mark">🌿</div><div><strong>GardenCare</strong><span>Business OS</span></div></div><button class="newjob" data-route="smart">⚡ Start New Job</button><nav class="nav">${navHTML()}</nav><div class="sidefoot">Offline-first GUI<br>Local data · AI-ready foundation<br>v0.6.0</div></aside><main class="main"><header class="top"><div style="display:flex;gap:10px;align-items:center"><button class="mobile-menu" id="menu">☰</button><input class="search" placeholder="Search customers, jobs, quotes…"></div><div class="topright"><button class="iconbtn" id="globalHelp">?</button><div class="user"><div class="avatar">NK</div><span><b>Nyaniso</b><small style="display:block;color:#718078">Administrator</small></span></div></div></header><section class="content" id="view"></section></main></div>`}
function dashboard(){return `<div class="hero"><div><div style="font-size:12px;letter-spacing:.12em;text-transform:uppercase;opacity:.75">GardenCare Business OS</div><h1>Good morning, Nyaniso 🌿</h1><p>Run the whole job from one place. Capture the customer, measure the garden, build the quote and carry the information through to the job and invoice.</p><div class="actions" style="margin-top:18px"><button class="btn" data-route="smart">⚡ Start New Job</button><button class="btn light" data-route="scan">🌱 GardenScan</button></div></div><div class="assistant"><strong>🤖 GardenCare Assistant</strong><div style="font-size:13px;line-height:1.5">Your workflow is ready. I can guide you through the next step without exposing internal costs to customers.</div></div></div><div class="grid4">${metric('Customers',db.customers.length,'Client records')}${metric('Open jobs',db.jobs.filter(j=>j.status!=='Completed').length,'Needs attention')}${metric('Quotes',db.quotes.length,'Created')}${metric('Outstanding',money(db.invoices.filter(i=>i.status!=='Paid').reduce((a,b)=>a+b.total,0)),'Customer balances')}</div><div class="section-head"><div><h2>Today at a glance</h2><p>Quick access to the work that matters.</p></div></div><div class="grid2"><div class="card"><div class="section-head" style="margin:0 0 10px"><div><h2>⚡ Continue working</h2><p>Start with one action and let GardenCare connect the rest.</p></div></div><div class="actions"><button class="btn" data-route="smart">Start a job</button><button class="btn secondary" data-route="customers">Add customer</button><button class="btn secondary" data-route="quotes">Review quotes</button></div></div><div class="card"><h3 style="margin-top:0">🤖 Assistant</h3><p style="color:var(--muted);line-height:1.5">${db.jobs.length?`You have ${db.jobs.filter(j=>j.status!=='Completed').length} open job(s).`:'No jobs yet. Start your first Smart Job to build the workflow.'}</p></div></div>`}
function smartView(){const c=db.customers.find(x=>x.id===smart.customerId);const names=['Customer','Property','Garden capture','Confirm area','Pricing','Quote & invoice'];let body='';if(smart.step===1)body=`<div class="card"><div class="info">Enter the customer once. Everything created in this workflow is linked automatically. ${help('Smart Job','This is the one-click field workflow. You can complete it yourself or later send a customer intake link for their part.')}</div><form id="customerForm" class="formgrid" style="margin-top:16px">${field('Full name','name','','text','Customer’s full name.')}${field('WhatsApp / mobile','phone','','tel','Number for updates and WhatsApp.')}${field('Email','email','','email','Optional.')}${field('Service','service','Lawn restoration','text','Main service requested.')}${field('Property address','address','','text','Full service address.',true)}${field('Access notes','access','','text','Gate, parking, security or access information.',true)}<div class="field full"><button class="btn">Continue →</button></div></form><div style="margin-top:12px"><button class="btn secondary" id="customerLink">🔗 Create customer intake link</button></div></div>`;
if(smart.step===2)body=`<div class="card"><div class="info">Confirm the property details. These stay attached to the customer and job. ${help('Property','Property information tells the field team where to work and stores access instructions.')}</div><form id="propertyForm" class="formgrid" style="margin-top:16px">${field('Address','address',c?.address||'','text','Confirm the service address.',true)}${field('GPS / location','gps','','text','Optional map pin or coordinates.')}${field('Property type','propertyType','Residential','text','Residential, complex, commercial, etc.')}${field('Access notes','access',c?.access||'','text','Instructions for entering the property.',true)}<div class="field full"><button class="btn">Continue → Garden Capture</button></div></form></div>`;
if(smart.step===3)body=`<div class="card"><div class="info"><b>Use multiple sources.</b> A photo alone is not an exact m² measurement. Combine evidence and compare the results. ${help('Garden Capture','Use camera photos, multiple images, video, manual/AR measurement and map/GPS. Live AI vision will be connected later through secure server-side APIs.')}</div><div class="capturegrid" style="margin-top:16px"><div class="capture"><h3>📷 Camera & photos</h3><p>Take one or multiple photos directly from the phone.</p><input id="photos" type="file" accept="image/*" capture="environment" multiple></div><div class="capture"><h3>🎥 Walkaround video</h3><p>Record the garden from several angles.</p><input id="video" type="file" accept="video/*" capture="environment"></div><div class="capture"><h3>📐 Manual / phone measurement</h3><p>Enter the result from a tape, AR/measurement app or another trusted method.</p><input id="manual" type="number" step="0.1" placeholder="m²"></div><div class="capture"><h3>🗺️ Map / GPS estimate</h3><p>Record the area from a map or mapped boundary.</p><input id="map" type="number" step="0.1" placeholder="m²"></div><div class="capture"><h3>🤖 AI visual estimate</h3><p>Prototype input now; secure live vision API later.</p><input id="ai" type="number" step="0.1" placeholder="m²"></div><div class="capture"><h3>📝 Notes</h3><p>Record obstacles or separate lawn sections.</p><textarea id="notes" rows="3" placeholder="Trees, paving, slopes, separate areas…"></textarea></div></div><div id="thumbs" class="thumbs"></div><div class="actions" style="margin-top:16px"><button class="btn" id="analyse">Compare measurements →</button></div></div>`;
if(smart.step===4){const ms=smart.measurements;const avg=ms.length?ms.reduce((a,b)=>a+b,0)/ms.length:0;const spread=ms.length?Math.max(...ms)-Math.min(...ms):0;const ratio=avg?spread/avg:1;const confidence=ms.length>=3&&ratio<=.12?'High':ms.length>=2&&ratio<=.2?'Medium':'Low';smart.area=avg||smart.area;body=`<div class="card"><div class="info ${confidence==='Low'?'warn':''}"><b>${confidence} confidence</b> · ${ms.length} measurement source(s). ${ms.length<2?'Add another independent measurement before finalising.':'The system compares the available sources; confirm the final area before quoting.'}</div><div class="workflow-summary" style="margin:16px 0"><div class="summary"><span>Average</span><b>${avg.toFixed(1)} m²</b></div><div class="summary"><span>Range</span><b>${ms.length?(Math.min(...ms).toFixed(1)+'–'+Math.max(...ms).toFixed(1)):'—'}</b></div><div class="summary"><span>Spread</span><b>${ms.length?spread.toFixed(1)+' m²':'—'}</b></div></div><div class="field">${field('Confirmed working area','confirmedArea',avg.toFixed(1),'number','Review all evidence and enter the area you want used for the quote.',true)}</div><div class="actions"><button class="btn secondary" id="backCapture">← Back</button><button class="btn" id="confirmArea">Confirm area →</button></div></div>`}
if(smart.step===5){const z=calc(smart.area);body=`<div class="grid2"><div class="card"><div class="info">This calculation uses your private business settings. Customers never see your supplier cost, labour cost, markup or profit. ${help('Internal pricing','The pricing engine combines material quantity, reserve bags, labour, travel, equipment and overhead before applying your internal markup.')}</div><div class="workflow-summary" style="margin:16px 0"><div class="summary"><span>Area</span><b>${smart.area.toFixed(1)} m²</b></div><div class="summary"><span>Required</span><b>${z.required} bags</b></div><div class="summary"><span>Take to site</span><b>${z.take} bags</b></div></div><table class="table"><tr><td>Material</td><td>${money(z.material)}</td></tr><tr><td>Labour</td><td>${money(z.labour)}</td></tr><tr><td>Travel</td><td>${money(z.travel)}</td></tr><tr><td>Equipment</td><td>${money(z.equip)}</td></tr><tr><td>Overhead</td><td>${money(z.overhead)}</td></tr><tr><th>True cost</th><th>${money(z.cost)}</th></tr><tr><th>Recommended selling price</th><th>${money(z.sell)}</th></tr></table></div><div class="card"><h3>🛍 Material safety</h3><p style="color:var(--muted)">Calculated requirement: <b>${z.required} bags</b><br>Reserve: <b>+${db.settings.reserveBags} bag(s)</b><br><strong>Take to site: ${z.take} bags</strong></p><div class="info">The reserve prevents a small measurement/material difference from leaving the team short on site.</div><div class="actions" style="margin-top:15px"><button class="btn secondary" id="backArea">← Review area</button><button class="btn" id="makeQuote">Create quote + job + invoice →</button></div></div></div>`}
if(smart.step===6){const q=db.quotes.at(-1),j=db.jobs.at(-1),i=db.invoices.at(-1);body=`<div class="card"><div class="info"><b>✓ Workflow created.</b> Customer, assessment, quote, job and invoice are linked. In production, the same IDs will be persisted to the database and file storage.</div><div class="grid4" style="margin-top:16px">${metric('Quote',q.id)}${metric('Job',j.id)}${metric('Invoice',i.id)}${metric('Materials',j.bags+' bags')}</div><div class="actions" style="margin-top:18px"><button class="btn" id="newAgain">⚡ Start another job</button><button class="btn secondary" id="copyQuote">📱 Copy customer message</button><button class="btn secondary" data-route="jobs">Open jobs</button></div></div>`}
return layout('⚡ Smart Job','One guided workflow — capture once, reuse everywhere.',`<div class="steps">${names.map((n,i)=>`<div class="step ${smart.step===i+1?'active':smart.step>i+1?'done':''}">${i+1}. ${n}</div>`).join('')}</div>${body}`)}
function customers(){return layout('👤 Customers','Customer records contain customer-facing information only; internal pricing stays protected.',`<div class="card"><div class="actions" style="margin-bottom:15px"><button class="btn" data-route="smart">+ New customer through Smart Job</button></div><div class="tablewrap"><table class="table"><thead><tr><th>Name</th><th>Phone</th><th>Service</th><th>Property</th></tr></thead><tbody>${db.customers.map(c=>`<tr><td><b>${esc(c.name)}</b></td><td>${esc(c.phone)}</td><td>${esc(c.service)}</td><td>${esc(c.address)}</td></tr>`).join('')||'<tr><td colspan="4" class="empty">No customers yet.</td></tr>'}</tbody></table></div></div>`) }
function properties(){const rows=db.customers.filter(c=>c.address);return layout('📍 Properties','Every property is linked to a customer so the field team has the right location and access notes.',`<div class="card"><div class="tablewrap"><table class="table"><thead><tr><th>Property</th><th>Customer</th><th>Type</th><th>Access</th></tr></thead><tbody>${rows.map(c=>`<tr><td>${esc(c.address)}</td><td>${esc(c.name)}</td><td>${esc(c.propertyType||'Residential')}</td><td>${esc(c.access||'—')}</td></tr>`).join('')||'<tr><td colspan="4" class="empty">Properties appear here after Smart Job intake.</td></tr>'}</tbody></table></div></div>`) }
function scan(){return layout('🌱 GardenScan','Use multiple measurement sources and confirm the final working area before quoting.',`<div class="card"><div class="info">${help('Why multiple methods?','Different methods can disagree. GardenCare should compare at least two independent measurements when possible instead of treating one photo or AI estimate as exact.') } <b>Recommended:</b> photos + manual/AR + map/GPS, with AI as another supporting estimate.</div><div class="capturegrid" style="margin-top:15px"><div class="capture"><h3>📷 Photos</h3><input id="standPhotos" type="file" accept="image/*" capture="environment" multiple></div><div class="capture"><h3>🎥 Video</h3><input type="file" accept="video/*" capture="environment"></div><div class="capture"><h3>📐 Manual / AR m²</h3><input id="standManual" type="number" step="0.1" placeholder="m²"></div><div class="capture"><h3>🗺️ Map m²</h3><input id="standMap" type="number" step="0.1" placeholder="m²"></div><div class="capture"><h3>🤖 AI m²</h3><input id="standAI" type="number" step="0.1" placeholder="m²"></div></div><div id="standResult" style="margin-top:15px"></div></div>`) }
function quotes(){return layout('📋 Quotes','Customer-facing prices are shown here; internal cost and markup remain private.',`<div class="card"><div class="tablewrap"><table class="table"><thead><tr><th>Quote</th><th>Customer</th><th>Service</th><th>Total</th><th>Status</th></tr></thead><tbody>${db.quotes.map(q=>`<tr><td>${q.id}</td><td>${esc(q.customerName)}</td><td>${esc(q.service)}</td><td>${money(q.total)}</td><td><span class="pill">${q.status}</span></td></tr>`).join('')||'<tr><td colspan="5" class="empty">No quotes yet.</td></tr>'}</tbody></table></div></div>`) }
function jobs(){return layout('🛠️ Jobs','Jobs inherit the customer, property, garden evidence, materials and quote.',`<div class="card"><div class="tablewrap"><table class="table"><thead><tr><th>Job</th><th>Customer</th><th>Area</th><th>Bags</th><th>Status</th><th></th></tr></thead><tbody>${db.jobs.map(j=>`<tr><td>${j.id}</td><td>${esc(j.customerName)}</td><td>${j.area} m²</td><td>${j.bags}</td><td><span class="pill ${j.status==='Completed'?'good':''}">${j.status}</span></td><td>${j.status!=='Completed'?`<button class="btn secondary" data-complete="${j.id}">Complete</button>`:''}</td></tr>`).join('')||'<tr><td colspan="6" class="empty">No jobs yet.</td></tr>'}</tbody></table></div></div>`) }
function employees(){return layout('👷 Employees','Internal workforce records. Customers cannot access this section.',`<div class="card"><form id="employeeForm" class="formgrid">${field('Employee name','name','','text','Full name.')}${field('Role','role','','text','For example Garden Assistant.')}${field('Internal hourly rate','rate',180,'number','Private labour cost.',true)}<div class="field full"><button class="btn">Add employee</button></div></form><div class="tablewrap" style="margin-top:18px"><table class="table"><thead><tr><th>Name</th><th>Role</th><th>Internal rate</th></tr></thead><tbody>${db.employees.map(e=>`<tr><td>${esc(e.name)}</td><td>${esc(e.role)}</td><td>${money(e.rate)}/hr</td></tr>`).join('')||'<tr><td colspan="3" class="empty">No employees yet.</td></tr>'}</tbody></table></div></div>`) }
function recruitment(){return layout('👥 Recruitment','Find, assess and prepare the right people. This is an internal area.',`<div class="grid2"><div class="card"><h3 style="margin-top:0">Add applicant ${help('Recruitment','Applicants are kept separate from active employees. Use the assessment score to support a consistent hiring decision.')}</h3><form id="appForm" class="formgrid">${field('Full name','name','','text','Applicant full name.')}${field('Phone','phone','','tel','Contact number.')}${field('Assessment score','score',0,'number','Enter the final assessment percentage.',true)}<div class="field full"><button class="btn">Save applicant</button></div></form></div><div class="card"><h3 style="margin-top:0">💡 How it works</h3><p style="color:var(--muted);line-height:1.6">1. Add applicant → 2. Complete assessment → 3. Review result → 4. Interview → 5. Hire and onboard.</p></div></div><div class="card" style="margin-top:18px"><div class="tablewrap"><table class="table"><thead><tr><th>Name</th><th>Phone</th><th>Score</th><th>Result</th></tr></thead><tbody>${db.applicants.map(a=>`<tr><td>${esc(a.name)}</td><td>${esc(a.phone)}</td><td>${a.score}%</td><td><span class="pill ${a.score>=70?'':'amber'}">${a.score>=70?'PASS':'REVIEW'}</span></td></tr>`).join('')||'<tr><td colspan="4" class="empty">No applicants yet.</td></tr>'}</tbody></table></div></div>`) }
function training(){return layout('🎓 Training','Internal staff training and pass/fail assessments.',`<div class="grid4">${['Induction','Safety','Lawn service','Equipment'].map(x=>`<div class="card"><h3>${x}</h3><p style="color:var(--muted);font-size:13px">Internal training module.</p><button class="btn secondary">Open</button></div>`).join('')}</div>`) }
function financials(){const paid=db.invoices.filter(i=>i.status==='Paid').reduce((a,b)=>a+b.total,0),exp=db.expenses.reduce((a,b)=>a+b.amount,0);return layout('💳 Financials','Private business information. Customers never see this page or its data.',`<div class="grid4">${metric('Paid income',money(paid))}${metric('Expenses',money(exp))}${metric('Net',money(paid-exp))}${metric('Outstanding',money(db.invoices.filter(i=>i.status!=='Paid').reduce((a,b)=>a+b.total,0)))}</div><div class="card" style="margin-top:18px"><form id="expenseForm" class="formgrid">${field('Expense description','description','','text','Fuel, supplier, equipment, etc.')}${field('Amount','amount',0,'number','Internal expense.',true)}<div class="field full"><button class="btn">Add expense</button></div></form></div>`) }
function reports(){return layout('📊 Reports','Operational summaries now; production analytics will use the database later.',`<div class="grid4">${metric('Customers',db.customers.length)}${metric('Jobs',db.jobs.length)}${metric('Quoted sales',money(db.quotes.reduce((a,b)=>a+b.total,0)))}${metric('Job cost',money(db.jobs.reduce((a,b)=>a+b.cost,0)))}</div><div class="card" style="margin-top:18px"><h3>Automation chain</h3><p style="color:var(--muted)">Smart Job links ${db.customers.length} customer(s), ${db.quotes.length} quote(s), ${db.jobs.length} job(s) and ${db.invoices.length} invoice(s).</p></div>`) }
function ai(){return layout('🤖 AI Assistant','A guided assistant layer ready for secure OpenAI, Claude and Gemini integrations later.',`<div class="grid2"><div class="card"><h3>🌱 Garden AI</h3><p style="color:var(--muted);line-height:1.6">Photo/video analysis, garden section detection, measurement cross-checking and confidence reporting.</p><div class="info">Live API keys are intentionally not stored in this browser GUI.</div></div><div class="card"><h3>💼 Business AI</h3><p style="color:var(--muted);line-height:1.6">Quote checks, pricing insights, profitability, follow-ups and operational summaries.</p><div class="info">Production connection will run through secure server-side routes.</div></div></div>`) }
function developer(){const s=db.settings;return layout('⚙️ Owner / Developer','Private controls for business rules. These values must never be exposed to customers.',`<div class="card"><div class="info">${help('Business settings','These values control internal calculations. Supplier cost, labour, overhead, markup and reserve rules are sensitive business information.')}</div><form id="settingsForm" class="formgrid" style="margin-top:16px">${field('Bag cost (R)','bagCost',s.bagCost,'number','Supplier cost per bag.')}${field('Coverage per bag (m²)','coverageM2',s.coverageM2,'number','Expected coverage per bag.')}${field('Wastage %','wastePct',s.wastePct,'number','Allowance before rounding up.')}${field('Reserve bags','reserveBags',s.reserveBags,'number','Extra whole bags to take to site.')}${field('Labour rate / hour','labourRate',s.labourRate,'number','Private labour cost.')}${field('Diesel price / L','dieselPrice',s.dieselPrice,'number','Internal fuel cost.')}${field('Fuel efficiency km/L','fuelKmPerLitre',s.fuelKmPerLitre,'number','Vehicle assumption.')}${field('Equipment cost / job','equipment',s.equipment,'number','Internal equipment/hire allowance.')}${field('Overhead %','overheadPct',s.overheadPct,'number','Business overhead allocation.')}${field('Markup %','markupPct',s.markupPct,'number','Internal selling markup.')}${field('Monthly maximum (R)','monthlyMax',s.monthlyMax,'number','Ceiling for monthly package calculations.') }<div class="field full"><button class="btn">Save business settings</button></div></form><div class="actions" style="margin-top:12px"><button class="btn secondary" id="backup">Export local backup</button><button class="btn danger" id="reset">Reset local data</button></div></div>`) }
function customerPortal(){return `<div class="customer-view"><div class="customer-card"><div class="brandline"><div class="brand-mark" style="background:#0b3b2b;color:white">🌿</div><div><b>GardenCare</b><div class="private">Customer information request</div></div></div><div class="card"><h1 style="font:800 30px 'Plus Jakarta Sans'">Tell us about your garden 🌱</h1><p style="color:var(--muted);line-height:1.6">Please provide the details we need to prepare your garden assessment. You only see and submit customer information.</p><div class="info">🔐 Your form does <b>not</b> expose GardenCare's internal costs, markup, profit, employees or business settings.</div><form id="portalForm" class="formgrid" style="margin-top:16px">${field('Full name','name','','text','Your name.')}${field('Mobile / WhatsApp','phone','','tel','Number we can use to contact you.')}${field('Email','email','','email','Optional.')}${field('Service needed','service','Lawn restoration','text','Tell us what you need.')}${field('Property address','address','','text','Where should the work happen?',true)}<div class="field full"><label>Photos ${help('Photos','Upload clear photos of the lawn and surrounding area. You may select more than one.')}</label><input type="file" accept="image/*" multiple><span class="hint">Photos help our team assess the work.</span></div><div class="field full"><label>Anything else?</label><textarea name="notes" rows="4" placeholder="Access information, preferred contact time, anything we should know…"></textarea></div><div class="field full"><button class="btn">Submit information →</button></div></form></div></div></div>`}
const views={dashboard,smart:smartView,customers,properties,scan,quotes,jobs,employees,recruitment,training,financials,reports,ai,developer};
function render(){if(new URLSearchParams(location.search).get('customer')==='1'){$('#app').innerHTML=customerPortal();attachPortal();return}if(!$('#app').innerHTML.includes('shell'))$('#app').innerHTML=shell();$('#view').innerHTML=views[route]?.()||dashboard();document.querySelectorAll('[data-route]').forEach(b=>b.onclick=()=>{route=b.dataset.route;$('#shell').classList.remove('open');render()});document.querySelectorAll('[data-help]').forEach(b=>b.onclick=()=>{const [t,x]=b.dataset.help.split('|');modal(`<div class="modalhead"><h2>ⓘ ${esc(t)}</h2><button class="close" data-close>×</button></div><p style="line-height:1.7;color:#52635b">${esc(x)}</p><button class="btn" data-close>Got it</button>`)});document.querySelectorAll('[data-close]').forEach(b=>b.onclick=closeModal);attachEvents()}
function modal(h){$('#modal').innerHTML=`<div class="modalbg"><div class="modalcard">${h}</div></div>`};function closeModal(){$('#modal').innerHTML=''}
function attachEvents(){const menu=$('#menu');if(menu)menu.onclick=()=>$('#shell').classList.toggle('open');$('#globalHelp')?.addEventListener('click',()=>modal(`<div class="modalhead"><h2>🌿 How GardenCare works</h2><button class="close" data-close>×</button></div><p style="line-height:1.7;color:#52635b"><b>Start New Job</b> is the normal field workflow. Information is captured once and linked to customer, property, GardenScan, quote, job and invoice. The customer portal is intentionally isolated from private business data.</p><div class="info">This v0.6 build is local-first. Database, secure storage, authentication and live AI providers come later.</div><button class="btn" data-close>Understood</button>`));document.querySelectorAll('[data-complete]').forEach(b=>b.onclick=()=>{const j=db.jobs.find(x=>x.id===b.dataset.complete);if(j){j.status='Completed';save();toast('Job completed')}});$('#customerLink')?.addEventListener('click',()=>{modal(`<div class="modalhead"><h2>🔗 Customer intake link</h2><button class="close" data-close>×</button></div><p style="color:#52635b;line-height:1.6">Demo customer link for the local GUI. In production this will become a secure, unique, expiring link tied to the lead/job.</p><div class="info"><b>${esc(location.href.split('?')[0])}?customer=1</b></div><button class="btn" id="copyLink">Copy link</button>`);$('#copyLink').onclick=()=>{navigator.clipboard?.writeText(location.href.split('?')[0]+'?customer=1');toast('Customer link copied')}});$('#analyse')?.addEventListener('click',()=>{smart.measurements=['manual','map','ai'].map(k=>Number($('#'+k)?.value)).filter(v=>v>0);smart.step=4;render()});$('#backCapture')?.addEventListener('click',()=>{smart.step=3;render()});$('#confirmArea')?.addEventListener('click',()=>{const x=Number($('[name=confirmedArea]')?.value);if(!(x>0))return toast('Enter a confirmed area');smart.area=x;smart.step=5;render()});$('#backArea')?.addEventListener('click',()=>{smart.step=4;render()});$('#makeQuote')?.addEventListener('click',()=>{const c=db.customers.find(x=>x.id===smart.customerId),z=calc(smart.area),qid=id('QUO'),jid=id('JOB'),iid=id('INV');db.quotes.push({id:qid,customerId:c.id,customerName:c.name,service:smart.service,total:z.sell,cost:z.cost,status:'Draft'});db.jobs.push({id:jid,customerId:c.id,customerName:c.name,service:smart.service,area:smart.area,bags:z.take,cost:z.cost,status:'Scheduled'});db.invoices.push({id:iid,customerId:c.id,customerName:c.name,total:z.sell,status:'Unpaid',quoteId:qid,jobId:jid});db.assessments.push({id:id('ASM'),customerId:c.id,area:smart.area,measurements:smart.measurements});smart.step=6;save()});$('#newAgain')?.addEventListener('click',()=>{smart={step:1,customerId:null,area:0,measurements:[],media:[],service:'Lawn restoration',property:{}};render()});$('#copyQuote')?.addEventListener('click',()=>{const q=db.quotes.at(-1),c=db.customers.find(x=>x.id===q.customerId);navigator.clipboard?.writeText(`GardenCare\nHi ${c.name}, your ${q.service} quote is ${money(q.total)}. Please reply if you would like to proceed.`);toast('Customer message copied')});document.querySelectorAll('#photos').forEach(x=>x.onchange=()=>{$('#thumbs').innerHTML=[...x.files].map(f=>`<img class="thumb" src="${URL.createObjectURL(f)}" alt="Garden photo">`).join('')});['standManual','standMap','standAI'].forEach(idn=>$('#'+idn)?.addEventListener('input',()=>{const vals=['standManual','standMap','standAI'].map(x=>Number($('#'+x)?.value)).filter(Boolean),avg=vals.length?vals.reduce((a,b)=>a+b,0)/vals.length:0;$('#standResult').innerHTML=`<div class="info ${vals.length<2?'warn':''}"><b>Current consensus:</b> ${avg?avg.toFixed(1)+' m²':'—'} from ${vals.length} source(s). ${vals.length<2?'Add another independent source for a better cross-check.':'Review the sources and confirm the final working area.'}</div>`}));}
document.addEventListener('submit',e=>{const f=e.target;e.preventDefault();const d=Object.fromEntries(new FormData(f));if(f.id==='customerForm'){const c={id:id('CUS'),name:d.name,phone:d.phone,email:d.email,service:d.service,address:d.address,access:d.access};db.customers.push(c);smart.customerId=c.id;smart.service=d.service;smart.step=2;save()}else if(f.id==='propertyForm'){const c=db.customers.find(x=>x.id===smart.customerId);Object.assign(c,{address:d.address,gps:d.gps,propertyType:d.propertyType,access:d.access});smart.step=3;save()}else if(f.id==='employeeForm'){db.employees.push({id:id('EMP'),name:d.name,role:d.role,rate:Number(d.rate)});save()}else if(f.id==='appForm'){db.applicants.push({id:id('APP'),name:d.name,phone:d.phone,score:Number(d.score)});save()}else if(f.id==='expenseForm'){db.expenses.push({id:id('EXP'),description:d.description,amount:Number(d.amount)});save()}else if(f.id==='settingsForm'){Object.keys(db.settings).forEach(k=>{if(d[k]!==undefined)db.settings[k]=Number(d[k])});save();toast('Business settings saved')}else if(f.id==='portalForm'){modal(`<div class="modalhead"><h2>✓ Thank you</h2></div><p style="line-height:1.7;color:#52635b">Your information has been submitted to GardenCare. In production it will create a secure lead/customer record and attach your photos without exposing internal business information.</p><button class="btn" data-close>Close</button>`);document.querySelector('[data-close]').onclick=closeModal}});
document.addEventListener('click',e=>{if(e.target.id==='backup'){const a=document.createElement('a');a.href=URL.createObjectURL(new Blob([JSON.stringify(db,null,2)],{type:'application/json'}));a.download='gardencare-local-backup.json';a.click()}if(e.target.id==='reset'&&confirm('Reset all local GardenCare data?')){localStorage.removeItem(KEY);db=load();render()}});
function attachPortal(){document.querySelectorAll('[data-help]').forEach(b=>b.onclick=()=>{const [t,x]=b.dataset.help.split('|');modal(`<div class="modalhead"><h2>ⓘ ${esc(t)}</h2><button class="close" data-close>×</button></div><p style="line-height:1.7">${esc(x)}</p><button class="btn" data-close>Got it</button>`)});document.querySelectorAll('[data-close]').forEach(b=>b.onclick=closeModal)}
render();
})();
